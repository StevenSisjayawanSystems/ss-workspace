# ---------- Game server (set these on Railway) ----------

# Required in production. Anyone who knows this code can enter, so treat it like a password.
INVITE_CODE=

# Call relay (TURN), so voice and video connect on strict office or mobile networks.
# Option A: Cloudflare Realtime TURN. Create a TURN key in the Cloudflare dashboard and copy both values.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Option B: any other TURN provider with fixed credentials (comma-separated URLs).
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Railway sets PORT itself. Locally the server uses 2567.
# PORT=2567

# ---------- Web app (set this on Vercel) ----------

# Address of the game server, starting with wss://. Not needed locally.
VITE_SERVER_URL=
