# ---------- Game server (set these on Railway) ----------

# Required in production. Anyone who knows this code can enter, so treat it like a password.
INVITE_CODE=

# Call relay (TURN), so voice and video connect on strict office or mobile networks.
# Option A: Cloudflare Realtime TURN. Create a TURN key in the Cloudflare dashboard and copy both values.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Option B: any other TURN provider with fixed credentials (comma-separated URLs).
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Accounts. With both set, people sign in with an email and password, and their progress, the bulletin board
# and the chat are kept in Supabase. Use the project's URL and its secret key; the secret key must never reach
# a browser. Leave both unset and everyone joins as a guest with nothing kept about them.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Only needed without Supabase: the folder where the bulletin board, desk claims, room bookings and the focus garden are kept. On Railway, attach a Volume
# to the server service, mount it at /data, and set this to /data. Without it, they are lost on every redeploy.
DATA_DIR=

# Railway sets PORT itself. Locally the server uses 2567.
# PORT=2567

# ---------- Web app (set this on Vercel) ----------

# Address of the game server, starting with wss://. Not needed locally.
VITE_SERVER_URL=

# The same Supabase project, for the sign-in screen: its URL and its publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
